{
  "name": "markovlab2",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "dev": "node scripts/dev-server.mjs",
    "build:data": "node scripts/build-data.mjs",
    "docs:matrix": "node scripts/build-completeness-matrix.mjs",
    "release:metadata": "node scripts/apply-production-url.mjs",
    "verify": "npm test && npm run docs:matrix",
    "test:e2e": "node tests/e2e-browser.mjs",
    "build": "node scripts/build-dist.mjs",
    "check:generated": "npm run build:data && npm run docs:matrix && node scripts/build-seo-pages.mjs && git diff --exit-code"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "playwright-core": "^1.62.1"
  }
}
